# Copy to backend/.env and fill in. NEVER commit backend/.env (it is gitignored).

# ---- Supabase (from Member B) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- web ----
WEB_ORIGIN=http://localhost:3000        # comma-separated; add the Vercel URL in production
IP_HASH_SALT=                           # any long random string: openssl rand -hex 32

# ---- speech to text ----
STT_PROVIDER=smallest                   # smallest | sarvam | openai (others are fallbacks)
SMALLEST_API_KEY=                       # AI Grants India voice credits (aigrants.in/v/sm)
SMALLEST_STT_MODEL=pulse
SMALLEST_STT_LANGUAGE=multi-indic       # en + hi/gu/mr/bn/or; retries with en if rejected
SARVAM_API_KEY=                         # optional fallback

# ---- pain scoring LLM (AI Grants India key: gpt-5-nano only, no transcription models) ----
OPENAI_API_KEY=
LLM_MODEL=gpt-5-nano
LLM_REASONING_EFFORT=minimal

# ---- scoring ----
VOICE_MATCH_THRESHOLD=0.6               # set after: python -m scripts.calibrate_voices
NOTIFY_WEBHOOK_URL=                     # viaSocket webhook from Member B (optional)

# ---- TigerGraph Savanna (optional, stage A8) ----
TG_HOST=
TG_GRAPH=pod
TG_SECRET=

# ---- local dev only ----
# FFMPEG_BIN=                           # path to a working ffmpeg if the system one is broken
# CHECK_EMAIL_DNS=true
# LOAD_MODELS=true
