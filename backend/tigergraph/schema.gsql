// Run once in the Savanna GSQL editor (stage A8), then install ring_of.gsql.
// Ids of Device / IpHash / EmailDomain are prefixed with the waitlist id, so links never
// cross waitlists.
CREATE VERTEX Signup (PRIMARY_ID id STRING, waitlist STRING, verdict STRING, trust INT) WITH primary_id_as_attribute="true"
CREATE VERTEX Device (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX IpHash (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX EmailDomain (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"

CREATE UNDIRECTED EDGE USED_DEVICE (FROM Signup, TO Device)
CREATE UNDIRECTED EDGE FROM_IP (FROM Signup, TO IpHash)
CREATE UNDIRECTED EDGE HAS_DOMAIN (FROM Signup, TO EmailDomain)
CREATE UNDIRECTED EDGE SOUNDS_LIKE (FROM Signup, TO Signup, similarity FLOAT)

CREATE GRAPH pod (Signup, Device, IpHash, EmailDomain, USED_DEVICE, FROM_IP, HAS_DOMAIN, SOUNDS_LIKE)
