// Adds our types to an existing graph (Savanna workspaces come with one).
// Run with: python -m scripts.tg_setup   (it replaces GRAPH_NAME with TG_GRAPH)
// Ids of Device / IpHash / EmailDomain are prefixed with the waitlist id, so links never
// cross waitlists.
USE GRAPH GRAPH_NAME
CREATE SCHEMA_CHANGE JOB pod_schema FOR GRAPH GRAPH_NAME {
  ADD VERTEX Signup (PRIMARY_ID id STRING, waitlist STRING, verdict STRING, trust INT) WITH primary_id_as_attribute="true";
  ADD VERTEX Device (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX IpHash (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX EmailDomain (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true";
  ADD UNDIRECTED EDGE USED_DEVICE (FROM Signup, TO Device);
  ADD UNDIRECTED EDGE FROM_IP (FROM Signup, TO IpHash);
  ADD UNDIRECTED EDGE HAS_DOMAIN (FROM Signup, TO EmailDomain);
  ADD UNDIRECTED EDGE SOUNDS_LIKE (FROM Signup, TO Signup, similarity FLOAT);
}
RUN SCHEMA_CHANGE JOB pod_schema
DROP JOB pod_schema
